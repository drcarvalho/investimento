PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Token gratuito opcional da brapi.dev (https://brapi.dev) — libera historico/dividendos de todas as acoes
# BRAPI_TOKEN=seu_token_brapi
# Chave gratuita opcional da bolsai.com (200 req/dia)
# BOLSAI_API_KEY=sua_chave_bolsai
# Bot Telegram (opcional — crie via @BotFather, 100% gratuito)
# TELEGRAM_BOT_TOKEN=seu_bot_token
# TELEGRAM_CHAT_ID=seu_chat_id
# Gemini API opcional (usa gemini-2.5-flash para resumo executivo sem inventar numeros)
# GEMINI_API_KEY=sua_chave_gemini
# Obrigatória em produção para disparar atualizações administrativas remotamente.
# Sem ela, o endpoint de atualização só funciona em desenvolvimento via loopback.
# ADMIN_API_KEY=chave_forte_aleatoria
# METRICS_TOKEN=token_metricas_opcional
# Lista extra de tickers detalhados quando BRAPI_TOKEN estiver configurado (separados por vírgula)
# BRAPI_DETAILED_TICKERS=BBAS3,WEGE3,BBSE3,EGIE3,TAEE11
# Cache distribuído opcional na Vercel via Upstash Redis (free tier)
# UPSTASH_REDIS_REST_URL=https://sua-instancia.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu_token_upstash
# Autenticação multiusuário opcional via Supabase Auth (JWT HS256)
# SUPABASE_JWT_SECRET=seu_jwt_secret_supabase
# REQUIRE_USER_AUTH=false
